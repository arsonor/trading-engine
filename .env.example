# ===========================================
# Trading Engine — Root Configuration (example)
# ===========================================
# Copy to `.env` and fill in real values. The BACKEND'S authoritative env file is
# `backend/.env` (mirror the same variables there for `uv run` from that directory).

# Application
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Database (Postgres only — SQLite is no longer supported in v2)
# Local dev via docker-compose.dev.yml (host port 5433 to avoid clashing with a
# native Postgres install on 5432):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/trading_engine

# ---------------------------------------------------------------------------
# Supabase (prod): TWO URLs, same host, different ports
# ---------------------------------------------------------------------------
# DATABASE_URL           -> TRANSACTION pooler, port 6543. The app runtime and the
#                           cron job. pgBouncer returns the server connection to the
#                           pool after every transaction, which suits many short queries.
#   postgresql+asyncpg://postgres.<ref>:<pw>@aws-<region>.pooler.supabase.com:6543/postgres
#
# MIGRATION_DATABASE_URL -> SESSION pooler, port 5432. `alembic upgrade head` only.
#                           The server connection is held for the whole client session,
#                           which is what DDL and Alembic's version bookkeeping assume.
#   postgresql+asyncpg://postgres.<ref>:<pw>@aws-<region>.pooler.supabase.com:5432/postgres
#
# MIGRATION_DATABASE_URL is OPTIONAL — unset means "use DATABASE_URL". Both endpoints
# are made pgBouncer-safe in code (app/core/db_connect.py), so migrating over 6543 works;
# 5432 is simply the endpoint Supabase intends for DDL.
#
# Why this matters: Alembic used to build its own engine that skipped the pgBouncer
# settings entirely, which failed on Render with
#   DuplicatePreparedStatementError: prepared statement "__asyncpg_stmt_1__" already exists
# Leave MIGRATION_DATABASE_URL empty for local Docker — there is no pooler.
# MIGRATION_DATABASE_URL=

# FMP (v2 data provider)
FMP_API_KEY=your_fmp_key_here
FMP_BASE_URL=https://financialmodelingprep.com

# FMP daily call budget (free/Basic tier is 250/day with a hard 429 stop).
# Keep the ceiling below the real cap so manual testing cannot exhaust it.
FMP_DAILY_BUDGET=230
FMP_TIMEOUT_SECONDS=20
FMP_MAX_RETRIES=3
FMP_RETRY_BACKOFF_SECONDS=1.0
FMP_FIXTURES_DIR=tests/fixtures/fmp

# RVOL implementation: simple | normalized
# `normalized` requires extended-hours intraday bars (FMP Premium / app V3) and
# raises FeatureRequiresIntraday in V1.
RVOL_MODE=simple

# Scanner thresholds (v2 — unused until Phase 2, but loadable now)
SCANNER_TIMEZONE=America/New_York
SCANNER_ENABLED=true
SCAN_FLOAT_MAX=75000000
SCAN_AVG_VOLUME_MIN=500000
SCAN_GAP_MIN=3.0
SCAN_GAP_MAX=15.0
SCAN_RVOL_MIN=10.0
SCAN_UPSIDE_MIN=5.5
SCAN_PRICE_FLOOR=2.0
# Liquidity floor in dollars (avg 20d volume x prior close)
SCAN_DOLLAR_VOLUME_MIN=1000000

# Threshold profile: production | demo
# `demo` loosens ONLY the float cap so free-tier mega-caps reach Stage 1 and the
# pipeline can be seen firing end to end. Demo output is illustrative, NOT actionable,
# and is stamped as such on every scan run and alert.
SCAN_PROFILE=production
SCAN_DEMO_FLOAT_MAX=20000000000
# Snapshot scenario feeding Stage 2 in V1 (no live pre-market data on the free tier)
SCAN_SNAPSHOT_FIXTURE=tests/fixtures/snapshots/demo_session.json

# Alpaca (v1 legacy — kept as a fallback smoke test until the scanner is proven, then removed)
ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# CORS: comma-separated or JSON array. In prod set to the Vercel frontend origin(s).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend (Vite) — read at build time, so also configure in Vercel project settings for prod
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
